{
  "name": "geohand",
  "private": true,
  "version": "0.1.0",
  "description": "GeoHand - learn Earth's interior with hand gestures or a mouse (MediaPipe + Three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/setup.mjs",
    "test": "node scripts/gesture-selftest.mjs && node scripts/content-check.mjs && node scripts/updates.mjs --check && node --test",
    "test:release": "node scripts/content-check.mjs --release",
    "inbox": "node --env-file=.env scripts/inbox.mjs",
    "updates": "node scripts/updates.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.14",
    "@upstash/redis": "^1.41.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  }
}
